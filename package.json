{
  "name": "ai-context-builder",
  "version": "0.1.0",
  "private": true,
  "description": "フリーランス・経営者向け AI コンテキスト構築アプリ。性格診断 + 音声インタビュー + シナリオから、AI が即座に『あなた』として振る舞うための実行型命令セット (Markdown) を生成する。",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "open:prod": "start https://ai-context-builder-five.vercel.app/"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "clsx": "^2.1.1",
    "next": "15.1.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.1.12",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
