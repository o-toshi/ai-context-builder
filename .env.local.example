# Gemini API key (Google AI Studio で取得)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# 既定のテキスト生成モデル
GEMINI_TEXT_MODEL=gemini-2.5-flash

# 混雑時に自動フォールバックするモデル（任意）
# 例: gemini-2.0-flash
# GEMINI_TEXT_FALLBACK_MODEL=

# 音声理解 / 文字起こしに使うモデル
GEMINI_AUDIO_MODEL=gemini-2.5-flash

# テスト実行（チャットプレビュー）用
GEMINI_CHAT_MODEL=gemini-2.5-flash

# テスト実行時のフォールバックモデル（任意）
# 例: gemini-2.0-flash
# GEMINI_CHAT_FALLBACK_MODEL=
